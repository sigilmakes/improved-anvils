{
    "schemaVersion": 1,
    "id": "improved_anvils",
    "version": "${version}",
    "name": "Improved Anvils",
    "description": "Removes \"TOO EXPENSIVE\" and re-balances enchantment/repair costs of anvils.",
    "authors": [
        "DavidJMacDonald"
    ],
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.davidjmacdonald.improved_anvils.ImprovedAnvils"
        ],
        "client": [
            "com.davidjmacdonald.improved_anvils.ImprovedAnvilsClient"
        ]
    },
    "mixins": [
        "improved_anvils.mixins.json",
        {
            "config": "improved_anvils.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*"
    },
    "contact": {
        "homepage": "https://modrinth.com/project/improved-anvils",
        "sources": "https://gitlab.com/davidjmacdonald1/improved-anvils",
        "issues": "https://gitlab.com/davidjmacdonald1/improved-anvils/-/issues"
    }
}
